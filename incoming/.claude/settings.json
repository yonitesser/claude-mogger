{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/config-notice.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/prefs-notice.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/cost-cap.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/require-approval.sh",
            "onFailure": "block",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/danger-guard.sh",
            "onFailure": "block",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-bash-read.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/hint-noisy-bash.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/secret-guard-bash.sh",
            "onFailure": "block",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-packages.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/taint-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*__(merge_pull_request|enable_pr_auto_merge|delete_repository|delete_branch|push_files|create_or_update_file|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/require-approval-mcp.sh",
            "onFailure": "block",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/secret-read-guard.sh",
            "onFailure": "block",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/config-guard.sh",
            "onFailure": "block",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-file-size.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/checkpoint.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/track-edits.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scope-guard.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-pipeline-files.sh",
            "onFailure": "block",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/secret-guard.sh",
            "onFailure": "block",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-decisions.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/require-tests-pass.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/require-smoke-pass.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-format.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-references.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/update-status.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-test-quality.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-test-tamper.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-risky-code.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-diy-payments.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-structure.sh",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-resilience.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/fix-loop-guard.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/record-test-run.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/repeat-call-guard.sh",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/taint-mark.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-done-means-done.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-tests-added.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-claim-check.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/update-status.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/fix-loop-guard.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/record-test-run.sh",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/repeat-call-guard.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/precompact-save.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "modules": [
    "../mods/mogger-status/hooks/register.tsx"
  ]
}
