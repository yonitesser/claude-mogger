# Copy to .env for local runs (never commit .env). Production sets these in the environment.
SLACK_WEBHOOK_URL=https://hooks.slack.invalid/services/XXX/YYY/ZZZ
DISCORD_WEBHOOK_URL=https://discord.invalid/api/webhooks/XXX
WEBHOOK_SECRET=replace-me
# optional: where notifications that could not be delivered are kept
NOTIFY_OUTBOX=var/failed-notifications.jsonl
